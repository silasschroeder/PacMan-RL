    "frightened_distance_reward": 2.0,
    "frightened_distance_penalty": -3.0,

    "personality_match_reward": 0.5,
    "personality_mismatch_penalty": -0.2,
    "personality_weight_start": 1.0,
    "personality_weight_end": 0.1,
    "personality_decay_episodes": 100,

    "coordination_reward": 0.3,
